<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KICKROOM — Sneaker Store</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>
  <div class="headbar">
    <div class="logo">KICK<span>ROOM</span></div>
    <button class="cart-btn" onclick="toggleDrawer(true)">
      Cart <span class="cart-count" id="cartCount">0</span>
    </button>
  </div>
</header>

<div class="wrap">
  <section class="hero">
    <h1>STEP INTO<br>YOUR NEXT PAIR.</h1>
    <p class="sub">Curated sneakers for people who care about what's on their feet. New drops weekly, no restocks promised.</p>
  </section>

  <div class="filters" id="filters"></div>
  <div class="grid" id="grid"></div>
</div>

<div class="overlay" id="overlay" onclick="toggleDrawer(false)"></div>
<div class="drawer" id="drawer">
  <div class="drawer-head">
    <h3>Your Cart</h3>
    <button class="drawer-close" onclick="toggleDrawer(false)">×</button>
  </div>
  <div class="drawer-items" id="drawerItems"></div>
  <div class="drawer-foot">
    <div class="total-row"><span>Total</span><span id="totalPrice">$0</span></div>
    <button class="checkout-btn" onclick="checkout()">Checkout</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<footer class="wrap">KICKROOM demo store — built for practice, not for real purchases.</footer>

<script src="script.js"></script>
</body>
</html>
